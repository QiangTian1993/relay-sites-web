# 飞书 Bitable 直连配置

# 飞书机器人（Bot）凭据 — 在飞书开发者后台 (https://open.feishu.cn) 创建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书 Base Token — 多维表格应用 URL 中的那段（bask... 开头）
# 兼容旧变量名：FEISHU_KB_TOKEN / KB_TOKEN
FEISHU_BASE_TOKEN=baskxxxxxxxxxxxxxxxx

# 数据源：auto=优先 data/*.json（快），缺失再打飞书；local=只读本地；feishu=只走飞书
DATA_SOURCE=auto
